{
  "name": "@devhorus/react-file-dropzone",
  "version": "0.0.0-development",
  "description": "A highly customizable React file dropzone component",
  "repository": "Evhorus/react-file-dropzone",
  "bugs": "https://github.com/Evhorus/react-file-dropzone/issues",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "semantic-release": "semantic-release"
  },
  "keywords": [
    "react",
    "dropzone",
    "file",
    "upload",
    "tailwind",
    "drag-and-drop",
    "file-upload"
  ],
  "author": "Evhorus",
  "license": "MIT",
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "semantic-release": "^25.0.3",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}